{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Carritos": {
    "MinutosRetencion": 5,
    "MaximoAsientosPorCarrito": 10,
    "PorcentajeMaximoRetenidoPorFuncion": 50,
    "CreacionesPorOrigen": 10,
    "VentanaCreacionMinutos": 10
  },
  "Invitados": {
    "TokenMinutosVigencia": 60
  },
  "Autenticacion": {
    "ClaimRoles": "roles"
  },
  "MercadoPago": {
    "Modo": "Simulado",
    "UrlRetorno": "http://localhost:5173/carritos/{carritoId}/pago",
    "SegundosTimeoutConsulta": 3
  },
  "Outbox": {
    "Habilitado": true,
    "IntervaloSegundos": 2,
    "MaximoIntentos": 8
  },
  "Email": {
    "Proveedor": "Registrador",
    "Remitente": "entradas@cinema.local"
  }
}
